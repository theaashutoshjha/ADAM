# ==============================================================================
# ADAM-AR Production Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env to Git!
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production
APP_URL=https://compliance.brokerage.com
ALLOWED_ORIGINS=https://compliance.brokerage.com,https://adam.pages.dev,https://adam.workers.dev

# Primary Compliance Administrator Credentials
# (Used to initialize the primary compliance account on first boot)
ADMIN_EMAIL=compliance-admin@brokerage.com
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production
COMPLIANCE_HEAD_EMAIL=compliance-head@brokerage.com
JWT_SECRET=use_a_secure_random_string_at_least_32_characters_long

# Deepgram Nova-3 Multi-Lingual Production ASR Engine (en, hi, ta, te)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# LLM Reasoning Engine (Stage 7 Q5 Compliance Evaluation)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Pipeline Performance & Worker Settings
TRANSCRIPTION_CONCURRENCY=4
AUDIT_CONCURRENCY=4
MAX_RETRIES=3
REQUEST_TIMEOUT=120000
QUEUE_BATCH_SIZE=10

# Database & Storage (Optional overrides, defaults to local .data/ directory)
DATABASE_PATH=
DATABASES_DIR=
UPLOADS_DIR=

# Enterprise SMTP Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=compliance@brokerage.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM=compliance@brokerage.com
SMTP_FROM_NAME=Compliance Desk

# External Telephony Integration (Optional)
TATA_ACCOUNT_ID=
TATA_API_KEY=
TATA_API_URL=
TATA_WEBHOOK_SECRET=
